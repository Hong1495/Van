{
  "appId": "com.hong1495.van",
  "productName": "Van",
  "copyright": "Copyright 2017-2026 draw.io Ltd",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}"
  ],
  "directories": {
    "output": "./dist/"
  },
  "npmRebuild": false,
  "publish": {
      "provider": "github"
  },
  "win": {
	"icon": "./build/icon.ico",
    "signtoolOptions": {
      "publisherName": ["JGraph Ltd", "draw.io Ltd"],
      "sign": "build/sign-trusted.mjs",
      "signingHashAlgorithms": ["sha256"]
    },
    "signExts": [".dll"],
    "target": [
      {
          "target": "nsis",
          "arch": [
            "arm64"
          ]
      },
      {
          "target": "portable",
          "arch": [
            "arm64"
          ]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-arm64-${version}-windows-arm64-installer.${ext}",
  	"oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": false,
    "createDesktopShortcut": false
  },
  "portable": {
    "artifactName": "${productName}-arm64-${version}-windows-arm64-no-installer.${ext}"
  },
  "afterPack": "build/fuses.mjs",
  "fileAssociations": [
	  {
	  	"ext": "drawio",
          "name": "Van Diagram",
          "description": "Van Diagram",
	  	"mimeType": "application/vnd.jgraph.mxfile",
	  	"role": "Editor"
	  },
	  {
	  	"ext": "vsdx",
	  	"name": "VSDX Document",
	  	"description": "VSDX Document",
	  	"mimeType": "application/vnd.visio",
	  	"role": "Editor"
	  },
	  {
	  	"ext": ["mmd", "mermaid"],
          "name": "Van Mermaid Diagram",
	  	"description": "Mermaid Diagram",
	  	"mimeType": "text/vnd.mermaid",
	  	"role": "Editor"
	  }
  ]
}
