{
  "appId": "com.hong1495.van",
  "productName": "Van",
  "copyright": "Copyright 2017-2026 draw.io Ltd",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}"
  ],
  "artifactName": "${productName}-${arch}-${version}.${ext}",
  "directories": {
    "output": "./dist/"
  },
  "npmRebuild": false,
  "linux": {
  	"executableName": "van",
    "category": "Graphics",
    "maintainer": "Hong1495 <van@hong1495.dev>",
    "icon": "./build",
    "desktop": {
      "entry": {
        "StartupWMClass": "van"
      }
    },
    "target": [
      "snap"
    ]
  },
  "snapcraft": {
    "base": "core24",
    "core24": {
      "useLXD": true,
      "plugs": [
        "default",
        "removable-media",
        "browser-support"
      ]
    }
  },
  "afterPack": "build/fuses.mjs",
  "fileAssociations": [
	  {
	  	"ext": "drawio",
          "name": "Van Diagram",
          "description": "Van Diagram",
	  	"mimeType": "application/vnd.jgraph.mxfile",
	  	"role": "Editor"
	  },
	  {
	  	"ext": "vsdx",
	  	"name": "VSDX Document",
	  	"description": "VSDX Document",
	  	"mimeType": "application/vnd.visio",
	  	"role": "Editor"
	  },
	  {
	  	"ext": ["mmd", "mermaid"],
          "name": "Van Mermaid Diagram",
	  	"description": "Mermaid Diagram",
	  	"mimeType": "text/vnd.mermaid",
	  	"role": "Editor"
	  }
  ]
}
