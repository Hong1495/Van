{
  "appId": "com.hong1495.van",
  "productName": "Van",
  "copyright": "Copyright 2017-2026 draw.io Ltd",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}"
  ],
  "artifactName": "${productName}-${arch}-${version}.${ext}",
  "directories": {
    "output": "./dist/"
  },
  "npmRebuild": false,
  "publish": {
      "provider": "github"
  },
  "win": {
	"icon": "./build/icon.ico",
    "target": [
      {
          "target": "appx",
          "arch": [
            "x64"
          ]
      }
    ]
  },
  "appx": {
    "displayName": "Van",
    "publisherDisplayName": "Hong1495",
    "identityName": "Hong1495.Van",
    "publisher": "CN=9E628CCB-BE04-4557-A5A8-81EC34B09733"
  },
  "afterPack": "build/fuses.mjs",
  "fileAssociations": [
	  {
	  	"ext": "drawio",
          "name": "Van Diagram",
          "description": "Van Diagram",
	  	"mimeType": "application/vnd.jgraph.mxfile",
	  	"role": "Editor"
	  },
	  {
	  	"ext": "vsdx",
	  	"name": "VSDX Document",
	  	"description": "VSDX Document",
	  	"mimeType": "application/vnd.visio",
	  	"role": "Editor"
	  },
	  {
	  	"ext": ["mmd", "mermaid"],
          "name": "Van Mermaid Diagram",
	  	"description": "Mermaid Diagram",
	  	"mimeType": "text/vnd.mermaid",
	  	"role": "Editor"
	  }
  ]
}
